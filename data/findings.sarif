              "name": "SCOPE-OVERBROAD",
              "shortDescription": {
                "text": "Server reach wider than its tools require"
              },
              "fullDescription": {
                "text": "The server listens on every network interface, accepts every web origin, or treats the home directory or filesystem root as the extent of what it will serve. Each is wider than a local tool needs whatever its tools do, and widens what any other flaw can reach."
              },
              "help": {
                "text": "The server listens on every network interface, accepts every web origin, or treats the home directory or filesystem root as the extent of what it will serve. Each is wider than a local tool needs whatever its tools do, and widens what any other flaw can reach."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "mcp"
                ]
              }
            }
          ]
        }
      },
